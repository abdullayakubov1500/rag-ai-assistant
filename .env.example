# Получите API-ключ в Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Модели Google AI Studio для Vector RAG
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Глобальные источники RAG (Google Docs / Google Sheets / Google Drive)
# Укажите полную ссылку или ID документа. Если не задано — используются локальные файлы из docs/rag/
GOOGLE_PRICE_LIST_DOC=https://docs.google.com/document/d/YOUR_PRICE_DOC_ID/edit
GOOGLE_FAQ_DOC=https://docs.google.com/document/d/YOUR_FAQ_DOC_ID/edit
GOOGLE_SCHEDULE_SHEET=https://docs.google.com/spreadsheets/d/YOUR_SCHEDULE_SHEET_ID/edit
GOOGLE_BOOKINGS_SHEET=https://docs.google.com/spreadsheets/d/YOUR_BOOKINGS_SHEET_ID/edit

# (Опционально) Для приватных документов через Google Cloud Console (Service Account):
# Если документы открыты по ссылке «Все, у кого есть ссылка — Читатель», эти два поля не обязательны.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
